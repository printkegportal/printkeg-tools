function renderResults() {
  const result = calculate();
  const product = getProduct();
  const platform = getPlatform();

  if (!result.valid) {
    $("results-container").innerHTML = `<div style="padding:2rem; color:var(--ink-500); font-family:var(--mono); font-size:0.875rem;">${result.error}</div>`;
    return;
  }

  // Profit number coloring
  const profitEl = $("profit-number");
  profitEl.textContent = fmt$(result.profitPerPrint);
  profitEl.className = "profit-number tabular " +
    (result.marginPercent < 0 ? "negative" : result.marginPercent < 30 ? "warning" : "positive");

  $("margin-percent").textContent = fmtPct(result.marginPercent) + " margin";

  // Verdict pill
  const verdictEl = $("margin-verdict");
  if (result.marginPercent < 0) {
    verdictEl.textContent = "Selling at a loss";
    verdictEl.className = "pill pill-negative";
  } else if (result.marginPercent < 20) {
    verdictEl.textContent = "Thin margin";
    verdictEl.className = "pill pill-warning";
  } else if (result.marginPercent < 40) {
    verdictEl.textContent = "Healthy margin";
    verdictEl.className = "pill pill-neutral";
  } else {
    verdictEl.textContent = "Strong margin";
    verdictEl.className = "pill pill-brand";
  }

  $("results-explainer").textContent = `After production, shipping, and ${platform.name} fees.`;
  $("total-profit").textContent = fmt$(result.totalProfit);
  $("break-even").innerHTML = result.breakEvenQuantity !== null
    ? `${result.breakEvenQuantity}<small>of ${result.quantity}</small>`
    : "—";

  // Breakdown
  $("breakdown-rows").innerHTML = `
    <div class="breakdown-row">
      <span class="breakdown-label">Selling price</span>
      <span class="breakdown-value">${fmt$(state.sellingPrice)}</span>
    </div>
    <div class="breakdown-row">
      <span class="breakdown-label subtract">Production cost (${fmt$(result.printRunSubtotal)} ÷ ${result.quantity})</span>
      <span class="breakdown-value subtract">− ${fmt$(result.costPerPrint)}</span>
    </div>
    <div class="breakdown-row">
      <span class="breakdown-label subtract">Shipping to you (${fmt$(result.shippingCost)} ÷ ${result.quantity})</span>
      <span class="breakdown-value subtract">− ${fmt$(result.shippingPerPrint)}</span>
    </div>
    <div class="breakdown-row">
      <span class="breakdown-label subtract">${platform.name} fees</span>
      <span class="breakdown-value subtract">− ${fmt$(result.platformFeesPerSale)}</span>
    </div>
    <div class="breakdown-divider">
      <div class="breakdown-row emphasis">
        <span class="breakdown-label">Profit per print</span>
        <span class="breakdown-value">${fmt$(result.profitPerPrint)}</span>
      </div>
    </div>
  `;

  $("product-link").href = `https://www.printkeg.com/products/${product.shopifyHandle}`;
  $("product-link").textContent = `See ${product.title} →`;
}

function renderChart() {
  const data = generateChartData();
  if (data.length < 2) {
    $("chart-section").style.display = "none";
    return;
  }
  $("chart-section").style.display = "";

  const svg = $("chart-svg");
  const W = 700, H = 260, padL = 50, padR = 24, padT = 16, padB = 36;
  const innerW = W - padL - padR;
  const innerH = H - padT - padB;

  const profits = data.map(d => d.profitPerPrint);
  const minY = Math.min(0, Math.min(...profits));
  const maxY = Math.max(...profits, 1);

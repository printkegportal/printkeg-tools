let activeSnippet = "iframe";
function renderSnippet() {
  $("snippet-pre").textContent = SNIPPETS[activeSnippet];
  document.querySelectorAll(".snippet-toggle .platform-btn").forEach(b => {
    b.classList.toggle("active", b.dataset.snippet === activeSnippet);
  });
}

$("embed-btn").addEventListener("click", () => {
  renderSnippet();
  $("embed-modal").hidden = false;
});

$("modal-close-btn").addEventListener("click", () => { $("embed-modal").hidden = true; });
$("modal-done-btn").addEventListener("click", () => { $("embed-modal").hidden = true; });
$("embed-modal").addEventListener("click", e => {
  if (e.target === $("embed-modal")) $("embed-modal").hidden = true;
});

document.querySelectorAll(".snippet-toggle .platform-btn").forEach(b => {
  b.addEventListener("click", () => {
    activeSnippet = b.dataset.snippet;
    renderSnippet();
  });
});

$("copy-snippet-btn").addEventListener("click", () => {
  navigator.clipboard.writeText(SNIPPETS[activeSnippet]).then(() => {
    $("copy-snippet-btn").textContent = "✓ Copied to clipboard";
    setTimeout(() => { $("copy-snippet-btn").textContent = "Copy snippet"; }, 2000);
  });
});

// ============================================================
// INIT
// ============================================================
function init() {
  // Embed mode detection
  const isEmbed = new URLSearchParams(window.location.search).get("embed") === "1";
  if (isEmbed) document.body.classList.add("embed-mode");

  state.selections = getDefaultSelections(getProduct());
  renderProductSelect();
  renderAll();
}

init();
</script>


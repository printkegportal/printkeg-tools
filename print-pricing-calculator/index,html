  ).join("");
}

function renderOptionControls() {
  const product = getProduct();
  const container = $("option-controls");
  container.innerHTML = product.options.map(opt => `
    <div class="form-group">
      <label class="field-label" for="option-${opt.name}">${opt.name}</label>

    const isCurrent = i === currentIdx;
    dotsHtml += `
      <circle cx="${x}" cy="${y}" r="${isCurrent ? 7 : 4}" fill="${isCurrent ? "#0f832b" : "#fff"}" stroke="#0f832b" stroke-width="${isCurrent ? 3 : 2}" data-idx="${i}" class="chart-dot" style="cursor:pointer"/>
    `;
  });

  // Axis label
  const axisLabelHtml = `<text x="${W / 2}" y="${H - 2}" text-anchor="middle" font-family="JetBrains Mono" font-size="10" fill="#7a766d" letter-spacing="1.5">RUN QUANTITY</text>`;

  svg.innerHTML = `
    ${yAxisHtml}
    ${xAxisHtml}
    ${axisLabelHtml}
    <path d="${path}" stroke="#0f832b" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    ${dotsHtml}
  `;

  // Tooltip wiring
  const tooltip = $("chart-tooltip");
  svg.querySelectorAll(".chart-dot").forEach(dot => {
    dot.addEventListener("mouseenter", e => {
      const i = parseInt(dot.dataset.idx, 10);
      const d = data[i];
      tooltip.innerHTML = `
        <div class="chart-tooltip-label">Quantity ${d.quantity}</div>
        <div>Profit: <strong>${fmt$(d.profitPerPrint)}/print</strong></div>
        <div style="color:var(--ink-300)">Margin: ${fmtPct(d.marginPercent)}</div>
        <div style="color:var(--ink-400)">Cost/print: ${fmt$(d.costPerPrint)}</div>
      `;
      const cx = parseFloat(dot.getAttribute("cx"));
      const cy = parseFloat(dot.getAttribute("cy"));
      const container = $("chart-container");
      const rect = container.getBoundingClientRect();
      const svgRect = svg.getBoundingClientRect();
      const x = (cx / W) * svgRect.width;
      const y = (cy / H) * svgRect.height;
      tooltip.style.left = (x + 12) + "px";
      tooltip.style.top = (y - 12) + "px";
      tooltip.classList.add("visible");
    });
    dot.addEventListener("mouseleave", () => tooltip.classList.remove("visible"));
  });

  $("chart-subtitle").textContent = `How profit per print changes with run size, holding selling price at ${fmt$(state.sellingPrice)}.`;
}

function renderAll() {
  renderOptionControls();
  renderResults();
  renderChart();
  renderPlatformGrid();
  renderPriceChips();
}

// ============================================================
// EVENTS
// ============================================================
$("product-select").addEventListener("change", e => {
  state.productId = e.target.value;
  state.selections = getDefaultSelections(getProduct());
  renderAll();
});

$("custom-cost-toggle").addEventListener("change", e => {
  state.useCustomCost = e.target.checked;
  $("custom-cost-group").style.display = state.useCustomCost ? "" : "none";
  renderResults();
  renderChart();
});

$("custom-cost-input").addEventListener("input", e => {
  state.customCostPerPrint = parseFloat(e.target.value) || 0;
  if (state.useCustomCost) { renderResults(); renderChart(); }
});

$("selling-price-input").addEventListener("input", e => {
  state.sellingPrice = parseFloat(e.target.value) || 0;
  renderResults();
  renderChart();
  renderPriceChips();
});

// Copy summary
$("copy-btn").addEventListener("click", () => {
  const result = calculate();
  const product = getProduct();
  const platform = getPlatform();
  if (!result.valid) return;
  const text = `${product.title} — ${result.quantity} prints

Production cost: ${fmt$(result.printRunSubtotal)} ($${result.costPerPrint.toFixed(2)}/print)
Shipping to me: ${fmt$(result.shippingCost)}
Total run cost: ${fmt$(result.totalRunCost)}

Selling on: ${platform.name}
Selling price: ${fmt$(state.sellingPrice)} per print
Platform fees: ${fmt$(result.platformFeesPerSale)} per sale

→ Profit per print: ${fmt$(result.profitPerPrint)}
→ Margin: ${fmtPct(result.marginPercent)}
→ Break-even: sell ${result.breakEvenQuantity} of ${result.quantity} to cover run

Calculated at tools.printkeg.com/print-pricing-calculator`;

  navigator.clipboard.writeText(text).then(() => {
    $("copy-btn-label").textContent = "Copied ✓";
    setTimeout(() => { $("copy-btn-label").textContent = "Copy summary"; }, 2000);
  });
});


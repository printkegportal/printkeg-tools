const state = {
  productId: "8x10-art-prints",
  selections: {},
  platformId: "etsy",
  sellingPrice: 25,
  useCustomCost: false,
  customCostPerPrint: 5.00,
};

// ============================================================
// UTIL
// ============================================================
const fmt$ = v => {
  if (v === null || v === undefined || isNaN(v)) return "—";
  const sign = v < 0 ? "-" : "";
  return sign + "$" + Math.abs(v).toFixed(2);
};
const fmtPct = v => {
  if (v === null || v === undefined || isNaN(v)) return "—";
  return v.toFixed(1) + "%";
};
const $ = id => document.getElementById(id);

const getProduct = () => PRICING.products.find(p => p.id === state.productId) || PRICING.products[0];
const getPlatform = () => PRICING.platforms.find(p => p.id === state.platformId);

function getDefaultSelections(product) {
  const sel = {};
  for (const opt of product.options) {
    if (opt.name === "Quantity") {
      const preferred = ["50", "100", "25"];
      sel[opt.name] = preferred.find(p => opt.values.includes(p)) || opt.values[Math.floor(opt.values.length / 2)];
    } else if (opt.name === "Material") {
      sel[opt.name] = opt.values.find(v => v.toLowerCase().includes("matte")) || opt.values[0];
    } else if (opt.name === "Sides") {
      sel[opt.name] = opt.values.find(v => v.includes("1")) || opt.values[0];
    } else if (opt.name === "Turnaround") {
      sel[opt.name] = opt.values.find(v => v.includes("2")) || opt.values[0];
    } else {
      sel[opt.name] = opt.values[0];
    }
  }
  return sel;
}

function findVariant(product, selections) {
  return product.variants.find(v => product.options.every(opt => v[opt.name] === selections[opt.name])) || null;
}

function calculateShipping(printRunSubtotal) {
  const tiers = PRICING.shipping.tiers;
  for (const tier of tiers) {
    if (tier.maxSubtotal === null || printRunSubtotal < tier.maxSubtotal) return tier.cost;
  }
  return tiers[tiers.length - 1].cost;
}

function calculatePlatformFees(sellingPrice, platform) {
  if (!platform) return 0;
  const tx = sellingPrice * (platform.transactionFeePercent / 100);
  const pay = sellingPrice * (platform.paymentFeePercent / 100) + (platform.paymentFeeFixed || 0);
  const listing = platform.listingFee || 0;
  return tx + pay + listing;
}

function calculate(opts = {}) {
  const product = getProduct();
  const platform = getPlatform();
  const variant = findVariant(product, state.selections);
  if (!variant && !state.useCustomCost) return { valid: false, error: "No matching variant." };

  const quantity = opts.quantityOverride !== undefined
    ? opts.quantityOverride
    : parseInt(state.selections.Quantity || "1", 10);
  if (!quantity || quantity < 1) return { valid: false, error: "Invalid quantity." };

  const printRunSubtotal = state.useCustomCost
    ? state.customCostPerPrint * quantity
    : variant.price;
  const costPerPrint = printRunSubtotal / quantity;
  const shippingCost = calculateShipping(printRunSubtotal);
  const shippingPerPrint = shippingCost / quantity;
  const landedCostPerPrint = costPerPrint + shippingPerPrint;
  const platformFeesPerSale = calculatePlatformFees(state.sellingPrice, platform);
  const profitPerPrint = state.sellingPrice - landedCostPerPrint - platformFeesPerSale;
  const marginPercent = state.sellingPrice > 0 ? (profitPerPrint / state.sellingPrice) * 100 : 0;
  const totalRunCost = printRunSubtotal + shippingCost;
  const contributionMarginPerSale = state.sellingPrice - platformFeesPerSale;
  const breakEvenQuantity = contributionMarginPerSale > 0 ? Math.ceil(totalRunCost / contributionMarginPerSale) : null;
  const totalProfit = profitPerPrint * quantity;

  return {
    valid: true,
    quantity, printRunSubtotal, costPerPrint, shippingCost, shippingPerPrint,
    landedCostPerPrint, platformFeesPerSale, sellingPrice: state.sellingPrice,
    profitPerPrint, marginPercent, breakEvenQuantity, totalRunCost, totalProfit,
  };
}

function generateChartData() {
  const product = getProduct();
  const platform = getPlatform();
  if (state.useCustomCost) {
    return [10, 25, 50, 100, 250, 500].map(q => {
      const result = calculate({ quantityOverride: q });
      return {
        quantity: q,
        profitPerPrint: result.profitPerPrint,
        marginPercent: result.marginPercent,
        costPerPrint: result.landedCostPerPrint,
      };
    });
  }
  const nonQty = product.options.filter(o => o.name !== "Quantity");
  const matching = product.variants.filter(v => nonQty.every(opt => v[opt.name] === state.selections[opt.name]));
  return matching.map(v => {
    const q = parseInt(v.Quantity, 10);
    if (!q) return null;
    const printRunSubtotal = v.price;
    const costPerPrint = printRunSubtotal / q;
    const shippingCost = calculateShipping(printRunSubtotal);
    const shippingPerPrint = shippingCost / q;
    const landedCostPerPrint = costPerPrint + shippingPerPrint;
    const platformFeesPerSale = calculatePlatformFees(state.sellingPrice, platform);
    const profitPerPrint = state.sellingPrice - landedCostPerPrint - platformFeesPerSale;
    const marginPercent = state.sellingPrice > 0 ? (profitPerPrint / state.sellingPrice) * 100 : 0;
    return { quantity: q, profitPerPrint, marginPercent, costPerPrint: landedCostPerPrint };
  }).filter(Boolean).sort((a, b) => a.quantity - b.quantity);
}

